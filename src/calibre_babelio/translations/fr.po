#: src/calibre_babelio/__init__.py:33
msgid "Downloads metadata and covers from Babelio (babelio.com)"
msgstr "Télécharge les métadonnées et les couvertures depuis Babelio (babelio.com)"

#: src/calibre_babelio/config.py:105
msgid "Babelio connection (anti-bot)"
msgstr "Connexion Babelio (anti-bot)"

#: src/calibre_babelio/config.py:110
msgid ""
"Babelio blocks automated requests. The <b>jstsToken</b> cookie proves a "
"request comes from a real logged-in browser session, so the plugin needs "
"a copy of yours:"
msgstr ""
"Babelio bloque les requêtes automatisées. Le cookie <b>jstsToken</b> "
"prouve qu'une requête provient d'une véritable session de navigateur "
"connectée ; l'extension a donc besoin d'une copie du vôtre :"

#: src/calibre_babelio/config.py:115
msgid "Open www.babelio.com in your browser and log in."
msgstr "Ouvrez www.babelio.com dans votre navigateur et connectez-vous."

#: src/calibre_babelio/config.py:118
msgid ""
"Open DevTools (F12) → <b>Application</b> tab → <b>Storage ▸ Cookies</b> →"
" <code>https://www.babelio.com</code>."
msgstr ""
"Ouvrez les outils de développement (F12) → onglet <b>Application</b> → "
"<b>Stockage ▸ Cookies</b> → <code>https://www.babelio.com</code>."

#: src/calibre_babelio/config.py:122
msgid "Find the <b>jstsToken</b> row and copy its <b>Value</b>."
msgstr "Trouvez la ligne <b>jstsToken</b> et copiez sa <b>Valeur</b>."

#: src/calibre_babelio/config.py:124
msgid "Paste it below."
msgstr "Collez-le ci-dessous."

#: src/calibre_babelio/config.py:127
msgid ""
"<i>This token expires after about 3 weeks; when imports start failing, "
"repeat these steps to paste a fresh one.</i>"
msgstr ""
"<i>Ce jeton expire après environ 3 semaines ; lorsque les imports "
"commencent à échouer, répétez ces étapes pour en coller un nouveau.</i>"

#: src/calibre_babelio/config.py:141
msgid "Paste the jstsToken value here"
msgstr "Collez la valeur du jstsToken ici"

#: src/calibre_babelio/config.py:143
msgid ""
"The Babelio session cookie. Expires after about 3 weeks; paste a fresh "
"one when imports start failing."
msgstr ""
"Le cookie de session Babelio. Il expire après environ 3 semaines ; "
"collez-en un nouveau lorsque les imports commencent à échouer."

#: src/calibre_babelio/config.py:146
msgid "Babelio cookie (jstsToken):"
msgstr "Cookie Babelio (jstsToken) :"

#: src/calibre_babelio/config.py:151
msgid ""
"Sent with every request; leave as-is unless requests are being blocked. "
"Use the same browser you copied the cookie from for best results."
msgstr ""
"Envoyé à chaque requête ; laissez tel quel sauf si les requêtes sont "
"bloquées. Utilisez le même navigateur que celui d'où vous avez copié le "
"cookie pour de meilleurs résultats."

#: src/calibre_babelio/config.py:154
msgid "Browser User-Agent (optional):"
msgstr "User-Agent du navigateur (facultatif) :"

#: src/calibre_babelio/config.py:161
msgid ""
"Minimum pause between requests to Babelio. Higher is slower but safer "
"against rate-limiting."
msgstr ""
"Pause minimale entre les requêtes vers Babelio. Plus elle est longue, "
"plus c'est lent mais sûr contre la limitation de débit."

#: src/calibre_babelio/config.py:164
msgid "Minimum delay between requests:"
msgstr "Délai minimum entre les requêtes :"

#: src/calibre_babelio/config.py:167 src/calibre_babelio/config.py:240
#: src/calibre_babelio/config.py:262 src/calibre_babelio/config.py:267
msgid "Test connection"
msgstr "Tester la connexion"

#: src/calibre_babelio/config.py:178
msgid "Metadata to import"
msgstr "Métadonnées à importer"

#: src/calibre_babelio/config.py:180
msgid "Choose which fields to fetch from Babelio."
msgstr "Choisissez les champs à récupérer depuis Babelio."

#: src/calibre_babelio/config.py:184
msgid "Comments"
msgstr "Commentaires"

#: src/calibre_babelio/config.py:185
msgid "Published date"
msgstr "Date de publication"

#: src/calibre_babelio/config.py:186
msgid "Publisher"
msgstr "Éditeur"

#: src/calibre_babelio/config.py:187
msgid "Rating"
msgstr "Note"

#: src/calibre_babelio/config.py:188
msgid "Series"
msgstr "Série"

#: src/calibre_babelio/config.py:189
msgid "Tags"
msgstr "Étiquettes"

#: src/calibre_babelio/config.py:198
msgid "Advanced options"
msgstr "Options avancées"

#: src/calibre_babelio/config.py:206
msgid ""
"How many search hits to look up; higher finds more but is slower and "
"riskier."
msgstr ""
"Nombre de résultats de recherche à consulter ; plus il est élevé, plus on"
" trouve, mais c'est plus lent et plus risqué."

#: src/calibre_babelio/config.py:208
msgid "Max results:"
msgstr "Nombre maximum de résultats :"

#: src/calibre_babelio/config.py:210
msgid "Allow cover download"
msgstr "Autoriser le téléchargement des couvertures"

#: src/calibre_babelio/config.py:215
msgid "Higher = more diagnostic logging."
msgstr "Plus élevé = plus de journalisation de diagnostic."

#: src/calibre_babelio/config.py:216
msgid "Verbosity:"
msgstr "Verbosité :"

#: src/calibre_babelio/config.py:240
msgid "Enter a jstsToken cookie first."
msgstr "Saisissez d'abord un cookie jstsToken."

#: src/calibre_babelio/config.py:245
msgid "Testing…"
msgstr "Test en cours…"

#: src/calibre_babelio/config.py:260
msgid "Connection OK"
msgstr "Connexion réussie"

#: src/calibre_babelio/config.py:277
#, python-brace-format
msgid "Connection failed: {error}"
msgstr "Échec de la connexion : {error}"

#: src/calibre_babelio/config.py:285
msgid "Babelio settings"
msgstr "Paramètres Babelio"

#: src/calibre_babelio/config.py:286
msgid ""
"The Babelio cookie and User-Agent are both required for imports to work. "
"Saving anyway, but identify will fail until they are filled in."
msgstr ""
"Le cookie Babelio et le User-Agent sont tous deux requis pour que les "
"imports fonctionnent. Enregistrement effectué quand même, mais "
"l'identification échouera tant qu'ils ne sont pas renseignés."

#: src/calibre_babelio/errors.py:28
msgid ""
"Babelio rejected the configured jstsToken cookie (it has likely expired):"
" paste a fresh one in the plugin settings (Preferences → Metadata "
"download → Babelio → Configure)."
msgstr ""
"Babelio a refusé le cookie jstsToken configuré (il a probablement expiré) : "
"collez-en un nouveau dans les paramètres de l'extension (Préférences → "
"Téléchargement des métadonnées → Babelio → Configurer)."

#: src/calibre_babelio/errors.py:36
msgid ""
"No Babelio jstsToken cookie is configured: paste one in the plugin "
"settings (Preferences → Metadata download → Babelio → Configure) before "
"importing."
msgstr ""
"Aucun cookie jstsToken Babelio n'est configuré : collez-en un dans les "
"paramètres de l'extension (Préférences → Téléchargement des métadonnées → "
"Babelio → Configurer) avant d'importer."

#: src/calibre_babelio/errors.py:42
msgid "Babelio access is temporarily blocked to avoid an IP ban; try again later."
msgstr ""
"L'accès à Babelio est temporairement bloqué pour éviter un bannissement "
"d'adresse IP ; réessayez plus tard."

